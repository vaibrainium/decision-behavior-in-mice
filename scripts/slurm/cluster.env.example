# Copy to <repo>/.env on the cluster and fill in. Sourced by scripts/slurm/*.slurm.
# Directory that holds processed/ (bound to /mnt/data in the container; config/dir-config.yaml expects
# /mnt/data/processed). Inputs: processed/ddm/ddm_inputs_global.npz. Fits are written to processed/ddm/fits/.
CLUSTER_DATA_PATH=/gscratch/walkerlab/<user>/mouse-decision-data
# Singularity image with torch, numba, numpy, pandas, scipy and omegaconf (the NHP image has all of them).
SIF_PATH=/gscratch/walkerlab/<user>/<nhp-data>/processed/nhp-prior.sif
